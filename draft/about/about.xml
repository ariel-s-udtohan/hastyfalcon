        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="about-hero" intro="&lt;p&gt;About Voltara&lt;/p&gt;&lt;p&gt;&lt;h1&gt;Energy for the long haul, not the short gain&lt;/h1&gt;&lt;/p&gt;&lt;p&gt;Voltara was founded in 2014 with a single belief: that supplying energy doesn&#x27;t have to mean exploiting customers. We&#x27;re a B Corp-certified supplier, employee-owned, and committed to net-zero by 2030.&lt;/p&gt;" model="about-hero" modelFields="[intro]" name="About Hero">
